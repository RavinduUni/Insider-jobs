# ─────────────────────────────────────────────────────────────
#  InsiderJobs — CLIENT environment variables (Vite)
#  Copy this file to client/.env and fill in your own values.
#  All variables MUST be prefixed with VITE_ to be exposed.
# ─────────────────────────────────────────────────────────────

# Backend API base URL
# Local dev:       http://localhost:5000
# Production URL:  https://your-deployed-backend.vercel.app
VITE_REACT_BACKEND_URL=http://localhost:5000
